# Copy this file to .env before deploying. Replace every value marked CHANGE_ME.
POSTGRES_DB=merchportal
POSTGRES_USER=merchportal
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARACTER_SECRET
COOKIE_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHARACTER_SECRET
TYPESENSE_API_KEY=CHANGE_ME_TYPESENSE_API_KEY
MINIO_ROOT_USER=merchportal
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=merchportal

# Browser-facing URLs. Set these to the HTTPS URLs exposed by your reverse proxy.
STOREFRONT_URL=http://localhost:8000
BACKEND_URL=http://localhost:9000
ADMIN_URL=http://localhost:9000
STOREFRONT_PORT=8000
BACKEND_PORT=9000
MINIO_CONSOLE_PORT=9001

# Add after creating a sales channel publishable key in Medusa Admin.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_setup_required
NEXT_PUBLIC_DEFAULT_REGION=mt
